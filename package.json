{
  "name": "gestor-imobiliario",
  "private": true,
  "version": "1.0.0",
  "description": "Gestor Imobiliário — PWA multi-utilizador em Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply gestor-imobiliario --local",
    "db:remote": "wrangler d1 migrations apply gestor-imobiliario --remote",
    "icons": "node scripts/make-icons.js",
    "test": "node --test \"testes/*.test.js\"",
    "test:watch": "node --test --watch \"testes/*.test.js\"",
    "test:ui": "node testes/ui/percorrer.js",
    "test:ui:avaliar": "node testes/ui/avaliar.js",
    "test:mutacao": "npm install --no-save --no-audit --no-fund @stryker-mutator/core@9 @stryker-mutator/tap-runner@9 && npx stryker run"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "wrangler": "^4.138.0"
  }
}
